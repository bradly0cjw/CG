#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include ".\GL\freeglut.h"

void ChangeSize(int, int);
void RenderScene(void);
void Menu(int index);

int _shadeModel = GL_FLAT;

void Menu(int index) {
    switch (index) {
    case 1: _shadeModel = GL_SMOOTH; break;
    case 2: _shadeModel = GL_FLAT; break;
    }
    glutPostRedisplay();
}

int main(int argc, char** argv)
{
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_DOUBLE | GLUT_RGB | GLUT_DEPTH);
    glutInitWindowSize(800, 600);
    glutInitWindowPosition(400, 80);
    glutCreateWindow("Simple Rectangle");

    glutCreateMenu(Menu);
    glutAddMenuEntry("smooth", 1);
    glutAddMenuEntry("flat", 2);
    glutAttachMenu(GLUT_RIGHT_BUTTON);

    glEnable(GL_DEPTH_TEST);

    glutReshapeFunc(ChangeSize);
    glutDisplayFunc(RenderScene);
    glutMainLoop();
    return 0;
}

void ChangeSize(int w, int h)
{
    if (h == 0) h = 1;
    glViewport(0, 0, w, h);
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();

    float aspect = (float)w / (float)h;
    gluOrtho2D(-4.0 * aspect, 4.0 * aspect, -4.0, 4.0);

    glMatrixMode(GL_MODELVIEW);
    glLoadIdentity();
}

void RenderScene(void)
{
    glClearColor(1.0f, 1.0f, 1.0f, 1.0f);
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
    glLoadIdentity();
    glShadeModel(_shadeModel);

    // Draw Orange Head (rectangular block)
    glBegin(GL_QUADS);
    glColor3f(1.0f, 0.65f, 0.0f);  // Orange
    
    // Front face of head
    glColor3f(1.0f, 0.8f, 0.2f);   // Light orange top-left
    glVertex2f(-1.0f, 2.0f);
    glColor3f(1.0f, 0.8f, 0.2f);   // Light orange top-right
    glVertex2f(1.0f, 2.0f);
    glColor3f(0.9f, 0.55f, 0.0f);  // Dark orange bottom-right
    glVertex2f(1.0f, 1.0f);
    glColor3f(0.9f, 0.55f, 0.0f);  // Dark orange bottom-left
    glVertex2f(-1.0f, 1.0f);
    glEnd();

    // Draw left ear (orange triangle)
    glBegin(GL_TRIANGLES);
    glColor3f(1.0f, 0.7f, 0.1f);
    glVertex2f(-1.2f, 2.3f);
    glColor3f(1.0f, 0.85f, 0.3f);
    glVertex2f(-0.7f, 2.5f);
    glColor3f(0.95f, 0.6f, 0.0f);
    glVertex2f(-0.8f, 2.0f);
    glEnd();

    // Draw right ear (orange triangle)
    glBegin(GL_TRIANGLES);
    glColor3f(1.0f, 0.7f, 0.1f);
    glVertex2f(1.2f, 2.3f);
    glColor3f(1.0f, 0.85f, 0.3f);
    glVertex2f(0.7f, 2.5f);
    glColor3f(0.95f, 0.6f, 0.0f);
    glVertex2f(0.8f, 2.0f);
    glEnd();

    // Draw left eye (small white)
    glBegin(GL_QUADS);
    glColor3f(1.0f, 1.0f, 1.0f);   // White
    glVertex2f(-0.6f, 1.6f);
    glVertex2f(-0.3f, 1.6f);
    glVertex2f(-0.3f, 1.4f);
    glVertex2f(-0.6f, 1.4f);
    glEnd();

    // Draw right eye (small white)
    glBegin(GL_QUADS);
    glColor3f(1.0f, 1.0f, 1.0f);   // White
    glVertex2f(0.3f, 1.6f);
    glVertex2f(0.6f, 1.6f);
    glVertex2f(0.6f, 1.4f);
    glVertex2f(0.3f, 1.4f);
    glEnd();

    // Draw Green Trapezoid Body
    glBegin(GL_QUADS);
    glColor3f(0.25f, 0.65f, 0.25f);  // Light green top-left
    glVertex2f(-0.8f, 1.0f);
    glColor3f(0.25f, 0.65f, 0.25f);  // Light green top-right
    glVertex2f(0.8f, 1.0f);
    glColor3f(0.15f, 0.5f, 0.15f);   // Dark green bottom-right
    glVertex2f(0.5f, -0.8f);
    glColor3f(0.15f, 0.5f, 0.15f);   // Dark green bottom-left
    glVertex2f(-0.5f, -0.8f);
    glEnd();

    glutSwapBuffers();
}
